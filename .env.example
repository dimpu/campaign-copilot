# Environment Variables
# Copy this to .env.local and fill in values

# Database (default: SQLite file in repo root, gitignored)
DATABASE_URL=file:./local.db

# ── AI / LLM ──
# Choose ONE provider below.
#
# Option A: LLMBox (ByteDance internal — recommended)
LLMBOX_API_KEY=
#
# Option B: OpenAI (public cloud)
OPENAI_API_KEY=
#
# Option C: Mock mode — deterministic offline responses, no API key needed
# LLM_MODE=mock
#
# If no API key is set and LLM_MODE is not mock, mock mode is used automatically.

# Auth (NextAuth v5)
AUTH_SECRET=dev-secret-change-in-production
AUTH_URL=http://localhost:3000

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000